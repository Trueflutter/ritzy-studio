# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Image generation routing: evolink (recommended; static key, Gemini via gateway), gemini (Vertex), or openai
RITZY_IMAGE_PROVIDER=evolink
EVOLINK_API_KEY=
EVOLINK_IMAGE_MODEL=gemini-3.1-flash-image-preview
EVOLINK_IMAGE_QUALITY=1K
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Local dev can use GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json.
# Vercel should use a base64-encoded service account JSON secret instead.
GOOGLE_APPLICATION_CREDENTIALS_JSON_BASE64=

RITZY_PRODUCT_REFERENCE_ORDERING_V2_ENABLED=false
# Visual sourcing image budget (S3): candidate product images per spec role and
# in total, shown to the visual pass at low detail. 0 disables images.
RITZY_PRODUCT_SOURCING_IMAGES_PER_ROLE=4
RITZY_PRODUCT_SOURCING_IMAGE_TOTAL=32

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Added 2026-09-01 (S0): previously-undocumented and new configuration ---

# Text/vision routing. OPENAI_BASE_URL routes ALL OpenAI SDK traffic through a gateway
# (the SDK reads it implicitly); leave unset for api.openai.com. When it IS set, the
# api.openai.com image fallback needs its own credential:
# OPENAI_BASE_URL=
# OPENAI_FALLBACK_API_KEY=

# Client-side deadline (ms) for text/vision calls (default 90000).
# RITZY_TEXT_TIMEOUT_MS=

# Per-stage text model/effort overrides. Stages: CLARIFYING_QUESTIONS,
# INSPIRATION_ANALYSIS, CONCEPT_DIRECTION, CONCEPT_PALETTE, PRODUCT_SOURCING,
# PRODUCT_VERIFICATION, SPATIAL_QA, REVISION_DIRECTION, SPEC_EXTRACTION,
# PRODUCT_ENRICHMENT, ANCHOR_SET. Effort: minimal|low|medium|high.
# RITZY_TEXT_MODEL_SPATIAL_QA=gpt-5-mini
# RITZY_TEXT_EFFORT_SPATIAL_QA=low

# Evolink gateway origin override (tests/stubs); default https://api.evolink.ai
# EVOLINK_BASE_URL=
# Credits-to-USD conversion for cost telemetry; default 68.
# EVOLINK_CREDITS_PER_USD=

# Reference-image guard: extra allowed hosts and extra strip-query hosts (comma lists;
# both EXTEND the built-in defaults).
# RITZY_REFERENCE_IMAGE_HOSTS=
# RITZY_REFERENCE_STRIP_QUERY_HOSTS=

# Final render execution: queue (Vercel) | inline (local); default auto.
# RITZY_RENDER_EXECUTION=

# Signup gate: comma list of emails/domains, or * to open; default ritzyinteriors.com.
# RITZY_SIGNUP_ALLOWLIST=

# Vertex/Gemini direct credentials (alternatives to the JSON_BASE64 form above):
# VERTEX_ACCESS_TOKEN=
# GOOGLE_OAUTH_ACCESS_TOKEN=
# GOOGLE_APPLICATION_CREDENTIALS=
