# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Image generation routing
RITZY_IMAGE_PROVIDER=gemini
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Local dev can use GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json.
# Vercel should use a base64-encoded service account JSON secret instead.
GOOGLE_APPLICATION_CREDENTIALS_JSON_BASE64=

RITZY_INTERIOR_PROMPT_V2_ENABLED=false
RITZY_FINAL_RENDER_PROMPT_V2_ENABLED=false
RITZY_PRODUCT_REFERENCE_ORDERING_V2_ENABLED=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
